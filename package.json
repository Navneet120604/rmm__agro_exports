{
  "name": "rmm__agro_exports",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @app/frontend --filter @app/backend dev",
    "dev:frontend": "pnpm --filter @app/frontend dev",
    "dev:backend": "pnpm --filter @app/backend dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @app/backend test:e2e"
  },
  "devDependencies": {}
}
