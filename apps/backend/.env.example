# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL with Drizzle ORM)
DATABASE_URL=postgresql://user:password@localhost:5432/rmm_agro_exports

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-64-character-secret
JWT_EXPIRES_IN=8h
COOKIE_SECRET=replace-with-a-secure-random-64-character-secret

# NestJS Observe (APM & Telemetry - optional)
# Sign up at https://observe.nestjs.com and run `npx @nestjs/observe link` to configure
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
